# Variables de `docker-compose.prod.yml`, à renseigner dans Coolify.
#
# Ce fichier est un modèle : il ne doit jamais contenir de secret réel. Coolify
# les stocke lui-même — rien de tout cela n'a vocation à être versionné.

# URL publique du front, sans slash final. L'API en dérive sa `redirect_uri`
# (`${PUBLIC_URL}/api/auth/callback`) et la destination de fin de parcours.
PUBLIC_URL=https://etape.beta.ordesoft.com

# URL publique de Keycloak, sans slash final. Sous-domaine distinct : le broker
# FranceConnect garde ainsi une adresse stable, indépendante du front.
KEYCLOAK_PUBLIC_URL=https://auth.etape.beta.ordesoft.com

# Console d'administration de Keycloak, à `${KEYCLOAK_PUBLIC_URL}/admin`.
# Le compte n'est créé qu'au tout premier démarrage : le changer ensuite ici
# n'aura aucun effet, il faudra passer par la console.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# Mot de passe de la base de Keycloak. Fixé une fois pour toutes au premier
# démarrage, quand PostgreSQL initialise son volume : le modifier plus tard sans
# détruire le volume empêche Keycloak de se connecter.
KEYCLOAK_DB_PASSWORD=

# Secret du client confidentiel `etape-api`, partagé entre l'API et Keycloak.
# C'est lui qui interdit l'échange de jetons depuis le navigateur, et donc ce
# qui justifie l'existence d'`apps/api`. `openssl rand -hex 32` fait l'affaire.
KEYCLOAK_CLIENT_SECRET=

# Identifiants FranceConnect (environnement d'intégration).
# Facultatifs : sans eux tout le reste fonctionne, seul le parcours
# FranceConnect reste indisponible.
FRANCECONNECT_CLIENT_ID=
FRANCECONNECT_CLIENT_SECRET=

# Compte de test `test@etape.local`, créé par le fichier de realm avec un mot de
# passe écrit en clair dans un dépôt public. Laissé vide, le compte est supprimé
# au déploiement ; renseigné (12 caractères minimum, politique du realm), il est
# conservé avec ce mot de passe-là.
KEYCLOAK_TEST_USER_PASSWORD=

# Serveur d'envoi. Sans lui, `verifyEmail` reste désactivé : ni inscription ni
# « mot de passe oublié ». Renseigner `SMTP_HOST` active les deux.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
