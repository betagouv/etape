# Variables de `docker-compose.prod.yml`, à renseigner chez l'hébergeur.
#
# Liste des variables, sans valeur : ce fichier est versionné, aucune valeur ne
# doit y figurer. Les valeurs vivent chez l'hébergeur, et le `.env` à jour dans
# le coffre-fort de l'équipe.

# URL publique du site vitrine et du simulateur, sans slash final.
PUBLIC_URL=

# URL publique de chaque front, sans slash final. Chacun relaie `/api` vers
# l'API, qui le reconnaît à son nom d'hôte et en dérive sa `redirect_uri`
# (`<url du front>/api/auth/callback`) et la destination de fin de parcours.
FRONT_OFFICE_PUBLIC_URL=
BACK_OFFICE_PUBLIC_URL=

# URL publique de Keycloak, sans slash final. Sous-domaine distinct : le broker
# FranceConnect garde ainsi une adresse stable, indépendante du front.
KEYCLOAK_PUBLIC_URL=

# Nom d'hôte de `KEYCLOAK_PUBLIC_URL`, sans le schéma. L'API doit joindre
# Keycloak sur son adresse publique — `openid-client` refuse un issuer qui ne
# correspond pas au document de découverte — et certains hôtes ne routent pas
# vers eux-mêmes une requête adressée à leur propre adresse publique. Le nom est
# donc pointé vers la passerelle de l'hôte, où écoute le proxy.
KEYCLOAK_HOSTNAME=

# Compte d'administration de Keycloak. La console n'existe plus dans l'image et
# le proxy refuse `/admin` : l'administration passe par `kcadm`, depuis la
# machine (voir `docs/deploiement.md`). Le compte n'est créé qu'au tout premier
# démarrage — le changer ensuite ici n'aura aucun effet.
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=

# Mot de passe de la base de Keycloak. Fixé une fois pour toutes au premier
# démarrage, quand PostgreSQL initialise son volume : le modifier plus tard sans
# détruire le volume empêche Keycloak de se connecter.
KEYCLOAK_DB_PASSWORD=

APP_DB_PASSWORD=

# Secret du client confidentiel `etape-api` de chaque realm (`etape` pour le
# front-office, `etape-back-office` pour le back-office), partagé entre l'API et
# Keycloak. C'est lui qui interdit l'échange de jetons depuis le navigateur, et
# donc ce qui justifie l'existence d'`apps/api`. Deux valeurs différentes,
# `openssl rand -hex 32` pour chacune.
FRONT_OFFICE_KEYCLOAK_CLIENT_SECRET=
BACK_OFFICE_KEYCLOAK_CLIENT_SECRET=

# Chiffrement du cookie de transaction de connexion : `openssl rand -base64 32`.
COOKIE_ENCRYPTION_KEY=

# Proxys devant l'API : celui de l'hébergeur puis le nginx de `web`.
TRUST_PROXY_HOPS=

# Identifiants FranceConnect (environnement d'intégration).
# Facultatifs : sans eux tout le reste fonctionne, seul le parcours
# FranceConnect reste indisponible.
FRANCECONNECT_CLIENT_ID=
FRANCECONNECT_CLIENT_SECRET=

# Environnement FranceConnect visé. Les identifiants ne valent que pour celui
# où ils ont été délivrés — s'y tromper produit un « client_id inconnu ».
#   INTEGRATION_STANDARD_V2         fcp-low.sbx      (bac à sable, défaut)
#   INTEGRATION_STANDARD_LEGACY_V2  fcp-low.integ01
#   PRODUCTION_STANDARD_V2          oidc.franceconnect.gouv.fr
FRANCECONNECT_ENVIRONMENT=

# Mot de passe du compte `test@etape.local`, conforme à la politique du realm.
# Vide : pas de compte de test.
KEYCLOAK_TEST_USER_PASSWORD=

# Serveur d'envoi. Sans lui, `verifyEmail` reste désactivé : ni inscription ni
# « mot de passe oublié ». Renseigner `SMTP_HOST` active les deux.
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=
SMTP_STARTTLS=
SMTP_SSL=

# reCAPTCHA de l'inscription. Avec SMTP et sans ces clés, l'inscription est fermée.
KEYCLOAK_RECAPTCHA_SITE_KEY=
KEYCLOAK_RECAPTCHA_SECRET_KEY=
KEYCLOAK_RECAPTCHA_V3=
