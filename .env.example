# Variables lues par `docker compose` (docker-compose.yml), pour le poste de
# développement. Liste sans valeur : ce fichier est versionné, aucune valeur ne
# doit y figurer. Le `.env` à jour se récupère dans le coffre-fort de l'équipe.

# Secret du client `etape-api` de chaque realm, posé par `keycloak-init`. Le
# même doit figurer dans `apps/api/.env`, sans quoi l'API ne peut plus échanger
# le code de connexion. `openssl rand -hex 32`.
KEYCLOAK_CLIENT_SECRET=
BACK_OFFICE_KEYCLOAK_CLIENT_SECRET=

# Mot de passe de `test@etape.local`, créé dans les deux realms. Vide : pas de
# compte de test. Politique du realm : 12 caractères, une majuscule, une
# minuscule, un chiffre, un caractère spécial.
KEYCLOAK_TEST_USER_PASSWORD=

# Facultatifs : sans eux, seul le parcours FranceConnect est indisponible.
FRANCECONNECT_CLIENT_ID=
FRANCECONNECT_CLIENT_SECRET=

# Facultatifs : sans eux, ni inscription ni « mot de passe oublié ».
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
