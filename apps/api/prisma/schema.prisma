
generator client {
  provider = "prisma-client"

  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Un compte par realm : le `sub` n'est unique qu'au sein de son émetteur, et
  // la même personne a deux comptes si elle utilise les deux fronts.
  keycloakRealm String @map("keycloak_realm")
  keycloakSub   String @map("keycloak_sub")

  email  String?
  prenom String?
  nom    String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  lastLoginAt DateTime @default(now()) @map("last_login_at") @db.Timestamptz(3)

  firstLoginIdentityProvider String @map("first_login_identity_provider")

  lastLoginIdentityProvider String @map("last_login_identity_provider")

  sessions Session[]

  @@unique([keycloakRealm, keycloakSub])
  @@map("account")
}

model Session {
  id String @id @db.Uuid

  accountId String  @map("account_id") @db.Uuid
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Front sur lequel la session a été ouverte (`front-office` ou `back-office`) :
  // l'API la refuse sur l'autre. Le navigateur n'envoie de lui-même le cookie
  // qu'au front qui l'a reçu, mais une personne peut copier son identifiant de
  // session depuis son navigateur et l'envoyer elle-même à l'autre front ; sans
  // cette colonne, l'API l'y accepterait.
  front String

  identityProvider String @map("identity_provider")

  claims Json

  idToken String @map("id_token")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  // Fin absolue, fixée à l'ouverture : l'activité ne la repousse jamais.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  // Fin faute d'activité, repoussée à chaque activité. Une échéance plutôt
  // que la date de la dernière activité : le délai dépend du front, et la
  // purge n'a ainsi qu'à comparer à maintenant.
  idleExpiresAt DateTime @map("idle_expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@index([idleExpiresAt])
  @@index([accountId])
  @@map("session")
}

// Copie du référentiel ROME de France Travail, rechargée quand sa version change.
model MetierRome {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  code    String @unique
  libelle String

  // Absent de la dernière version importée : gardé pour ce qui le cite déjà.
  isObsolete Boolean @default(false) @map("is_obsolete")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  appellations AppellationRome[]

  @@map("metier_rome")
}

model AppellationRome {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  code String @unique

  metierRomeId String     @map("metier_rome_id") @db.Uuid
  metierRome   MetierRome @relation(fields: [metierRomeId], references: [id])

  libelle        String
  libelleCourt   String                        @map("libelle_court")
  classification ClassificationAppellationRome

  isObsolete Boolean @default(false) @map("is_obsolete")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@index([metierRomeId])
  @@map("appellation_rome")
}

enum ClassificationAppellationRome {
  PRINCIPALE
  SYNONYME
}

model VersionRome {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  version String @unique

  // Celle de France Travail (`lastModifiedDate`) ; `created_at` date l'import.
  dateModification DateTime @map("date_modification") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("version_rome")
}
