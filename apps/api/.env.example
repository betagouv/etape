# Liste des variables, sans valeur : ce fichier est versionné, aucune valeur ne
# doit y figurer. Le `.env` à jour se récupère dans le coffre-fort de l'équipe.

NODE_ENV=
API_PORT=

# URL publique de l'API, **préfixe `/api` inclus** — l'application le porte
# elle-même (voir `src/main.ts`). La `redirect_uri` en est dérivée :
# `${API_BASE_URL}/auth/callback`, à déclarer à l'identique dans le client Keycloak.
API_BASE_URL=

# URL publique du front, sans slash final. Destination de fin de parcours
# (connexion, déconnexion, échec) : le front-office en local. Un seul front à la
# fois pour l'instant ; pour tester le back-office, y mettre
# http://localhost:5174.
FRONT_BASE_URL=

# Issuer du realm. Avec le `docker-compose.yml` fourni, Keycloak écoute sur 8080.
KEYCLOAK_ISSUER_URL=
KEYCLOAK_CLIENT_ID=

# Secret du client confidentiel. C'est lui qui interdit de faire l'échange de
# jetons depuis le navigateur, et donc ce qui justifie cette API.
#
# En développement, le même que `KEYCLOAK_CLIENT_SECRET` dans le `.env` à la
# racine, que `keycloak-init` pose dans le realm. Les autres environnements
# reçoivent le leur par `kcadm`, jamais par ce fichier.
KEYCLOAK_CLIENT_SECRET=

# `alias` de l'identity provider FranceConnect dans le realm.
KEYCLOAK_FRANCECONNECT_ALIAS=

# `openssl rand -base64 32`
COOKIE_ENCRYPTION_KEY=

TRUST_PROXY_HOPS=

DATABASE_URL=
