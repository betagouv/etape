# Liste des variables, sans valeur : ce fichier est versionné, aucune valeur ne
# doit y figurer. Le `.env` à jour se récupère dans le coffre-fort de l'équipe.

NODE_ENV=
API_PORT=

# Un front, une origine : chacun relaie `/api` vers cette API, qui le reconnaît
# à l'en-tête `Host`. URL du front sans slash final ; URL de l'API **préfixe
# `/api` inclus**, sur la même origine — la `redirect_uri` en dérive,
# `${…_API_BASE_URL}/auth/callback`, à déclarer à l'identique dans le realm.
#
# Secret du client `etape-api` du realm de chaque front : le même que dans le
# `.env` à la racine, que `keycloak-init` pose dans le realm. Les autres
# environnements reçoivent le leur par `kcadm`, jamais par ce fichier.
FRONT_OFFICE_BASE_URL=
FRONT_OFFICE_API_BASE_URL=
FRONT_OFFICE_KEYCLOAK_CLIENT_SECRET=
BACK_OFFICE_BASE_URL=
BACK_OFFICE_API_BASE_URL=
BACK_OFFICE_KEYCLOAK_CLIENT_SECRET=

# Keycloak, sans slash final ni realm : chaque front a le sien (`etape`,
# `etape-back-office`).
KEYCLOAK_URL=
KEYCLOAK_CLIENT_ID=

# `alias` de l'identity provider FranceConnect dans le realm.
KEYCLOAK_FRANCECONNECT_ALIAS=

# `openssl rand -base64 32`
COOKIE_ENCRYPTION_KEY=

TRUST_PROXY_HOPS=

DATABASE_URL=
