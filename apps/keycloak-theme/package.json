{
  "name": "@etape/keycloak-theme",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "prettier": "@etape/prettier-config",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:bundle && keycloakify build",
    "build:bundle": "keycloakify sync-extensions && tsc --noEmit && vite build",
    "lint": "eslint",
    "test": "vitest run",
    "storybook": "keycloakify start-keycloak"
  },
  "dependencies": {
    "@etape/ui": "workspace:*",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "altcha": "^3.5.0",
    "keycloakify": "^11.16.4",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@etape/eslint-config": "workspace:*",
    "@etape/prettier-config": "workspace:*",
    "@tailwindcss/vite": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
