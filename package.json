{
  "name": "etape",
  "version": "0.0.0",
  "private": true,
  "prettier": "@etape/prettier-config",
  "scripts": {
    "dev": "turbo run dev",
    "dev:stack": "node scripts/dev-stack.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "start": "turbo run start",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css}\"",
    "check:workspace-map": "node scripts/check-workspace-map.mjs",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,css}": "prettier --write",
    "apps/api/**/*.ts": "pnpm --filter @etape/api run lint --fix",
    "apps/back-office/**/*.{ts,tsx}": "pnpm --filter @etape/back-office run lint --fix",
    "apps/front-office/**/*.{ts,tsx}": "pnpm --filter @etape/front-office run lint --fix",
    "apps/keycloak-theme/**/*.{ts,tsx}": "pnpm --filter @etape/keycloak-theme run lint --fix",
    "apps/simulateur/**/*.{ts,tsx}": "pnpm --filter @etape/simulateur run lint --fix",
    "apps/site/**/*.{ts,tsx}": "pnpm --filter @etape/site run lint --fix",
    "packages/api-client/**/*.ts": "pnpm --filter @etape/api-client run lint --fix",
    "packages/api-contract/**/*.ts": "pnpm --filter @etape/api-contract run lint --fix",
    "packages/session/**/*.{ts,tsx}": "pnpm --filter @etape/session run lint --fix",
    "packages/ui/**/*.{ts,tsx}": "pnpm --filter @etape/ui run lint --fix"
  },
  "devDependencies": {
    "@etape/prettier-config": "workspace:*",
    "@inquirer/checkbox": "^5.2.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2"
  },
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=24"
  }
}
