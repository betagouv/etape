{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "out/**",
        "dist/**",
        "dist_keycloak/**",
        "src/generated/**",
        "!.next/cache/**"
      ],
      /*
       * Les exports statiques figent ces valeurs au build : sans les déclarer,
       * Turborepo servirait depuis son cache un export construit avec l'URL
       * d'API d'un autre environnement.
       */
      "env": ["NODE_ENV", "NEXT_PUBLIC_API_BASE_URL"],
      "passThroughEnv": ["DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      // Suite d'intégration de l'API (ignorée sans ces variables) : le
      // résultat dépend de la base visée, donc de la clé de cache.
      "env": ["TEST_DATABASE_URL", "TEST_DATABASE_ADMIN_URL"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
