{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "out/**",
        "dist/**",
        "dist_keycloak/**",
        "src/generated/**",
        "!.next/cache/**"
      ],
      /*
       * Les bundles Vite figent ces valeurs au build : sans les déclarer,
       * Turborepo servirait depuis son cache un build construit avec l'URL
       * d'API d'un autre environnement.
       */
      "env": ["NODE_ENV", "VITE_API_BASE_URL"],
      "passThroughEnv": ["DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
